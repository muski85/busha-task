# Copy to .env and fill in. .env is gitignored - never commit it.
#
# No VITE_ prefix: these stay server side, read by the vite proxy in dev and
# the edge function in production. Anything prefixed VITE_ is inlined into the
# browser bundle and is public.

BUSHA_BASE_URL=https://api.sandbox.busha.so
BUSHA_API_KEY=
